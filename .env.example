# Copia este archivo a .env.local y completa los valores. .env.local no se versiona.

# Supabase: URL del proyecto y clave publicable. Pueden usarse en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=

SUPABASE_SECRET_KEY=

OWNER_EMAIL=
OWNER_PASSWORD=

# Consulta de RUC en la proforma (api.decolecta.com). Solo servidor: nunca con NEXT_PUBLIC_.
# Sin valor, el RUC del cliente se escribe a mano.
DECOLECTA_TOKEN=

# Envío automático por WhatsApp: clave que cifra la sesión vinculada (32 bytes en base64). Solo
# servidor. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin valor, «Enviar por WhatsApp» abre el chat con el mensaje.
WHATSAPP_SESSION_KEY=
